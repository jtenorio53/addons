<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mass_confirm_quotation_wizard" model="ir.ui.view">
        <field name="name">view.mass.confirm.quotation.wizard</field>
        <field name="model">mass.confirm.quotation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p class="text-danger">"Are you sure you want to confirm Quotation?"</p>
                    <footer>
                        <button string="APPLY" type="object" name="confirm" class="btn-primary"/>
                        <button string="DISCARD" special="cancel" name="cancel" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mass_confirm_quotation_wizard" model="ir.actions.act_window">
        <field name="name">Confirm Quotation</field>
        <field name="res_model">mass.confirm.quotation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">list</field>
    </record>

</odoo>


