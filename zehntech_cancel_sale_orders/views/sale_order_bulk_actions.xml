<odoo>
    <!-- Bulk Actions for Sale Orders -->
    <record id="action_bulk_cancel_only" model="ir.actions.server">
        <field name="name">Bulk Cancel Only</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">records.action_bulk_cancel_only()</field>
    </record>

    <record id="action_bulk_reset_to_draft" model="ir.actions.server">
        <field name="name">Bulk Set to Quotation</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">records.action_bulk_reset_to_draft()</field>
    </record>

    <record id="action_bulk_cancel_and_delete" model="ir.actions.server">
        <field name="name">Bulk Cancel and Delete</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">records.action_bulk_cancel_and_delete()</field>
    </record>

    <!-- Add Bulk Actions to Sale Order Tree View -->
    <record id="sale_order_tree_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.bulk.actions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                        <button name="action_bulk_cancel_only" type="object" string="Bulk Cancel Only" class="btn btn-primary"/>
                        <button name="action_bulk_reset_to_draft" type="object" string="Bulk Set to Quotation" class="btn btn-secondary"/>
                        <button name="action_bulk_cancel_and_delete" type="object" string="Bulk Cancel and Delete" class="btn btn-danger"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
