<odoo>
    <record id="action_bulk_cancel_only" model="ir.actions.server">
        <field name="name">Bulk Cancel Only</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">env['sale.order'].browse(records.ids).action_cancel_only()</field>
    </record>

    <record id="action_bulk_reset_to_draft" model="ir.actions.server">
        <field name="name">Bulk Set to Quotation</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">env['sale.order'].browse(records.ids).action_reset_to_draft()</field>
    </record>

    <record id="action_bulk_cancel_and_delete" model="ir.actions.server">
        <field name="name">Bulk Cancel and Delete</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">env['sale.order'].browse(records.ids).action_cancel_and_delete()</field>
    </record>
</odoo>
